#!/bin/bash
# The paid model runs (DEC-24, C8): scripts/paid_runs status|advance|serve|smoke --out runs/EXP-<id>_paid_runs [...]
# Reads ANTHROPIC_API_KEY and OPENROUTER_API_KEY from the environment (~/.zshenv); never pass a key on the command line.
set -e
cd "$(dirname "$0")/.."
[ -f "$HOME/.zshenv" ] && source "$HOME/.zshenv" >/dev/null 2>&1 || true
exec ./.venv/bin/python -m strokecopilot.pipeline.paid_runs "$@"
